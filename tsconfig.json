{
  "compilerOptions": {
    /* Basic Options */
    "target": "es2018",
    "module": "esNext",
    "moduleResolution": "node",
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "checkJs": false,
    "jsx": "react",
    "incremental": true,
    "noEmit": true,
    "skipLibCheck": true,

    /* Strict Type-Checking Options */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    /* Additional Checks */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,

    /* Module Resolution Options */
    "baseUrl": ".",
    "paths": {
      "/*": ["./*"]
    },
    "resolveJsonModule": true,
    "types": ["meteor", "node"],
    "esModuleInterop": true,
    "preserveSymlinks": true
  },
  "include": [
    "client",
    "server",
    "imports",
    "types",
    "declarations.d.ts",
    "lucide-react.d.ts",
    "stitches.config.ts"
  ],
  "exclude": ["node_modules", ".meteor", "packages", "media"]
}
