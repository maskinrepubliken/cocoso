{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["client/main.js", "server/main.js", "imports/startup/client/index.jsx", "imports/startup/server/index.js"],
  "project": ["imports/**/*.{js,jsx,ts,tsx}", "client/**/*.{js,jsx,ts,tsx}", "server/**/*.{js,jsx,ts,tsx}"],
  "ignore": ["declarations.d.ts", "lucide-react.d.ts"],
  "ignoreDependencies": ["@babel/runtime", "meteor-node-stubs", "patch-package"],
  "ignoreUnresolved": ["^meteor/.*"]
}
