#!/usr/bin/env bash
# Rolls out the image tagged :production on this server. Run as root, by the
# deploy workflow over SSH (the `deploy` user may run only this, through sudo)
# or by hand. Takes no arguments: what runs is decided by which image GitHub
# has tagged :production (.github/workflows/deploy.yml).
#
# Pulls the image, runs the data migrations the database has not seen,
# recreates the app, and waits for it to answer. If it does not answer in
# time, the previous image is put back and the script fails, so the workflow
# run turns red while the site keeps running the old version.
#
# Data migrations: the image carries scripts/migrations/ with its ORDER file.
# Every script listed there and not recorded in the `dataMigrations`
# collection is run, in that order and with APPLY set, after a dump of the
# database to /var/backups/cocoso/pre-migration/. Scripts marked `manual` are
# only reported as waiting (run those with deploy/production/run-mongosh.sh).
# A script that fails stops the deploy before the app is touched. Going back
# to the previous image does not undo a migration; the dump is there for that.
set -euo pipefail

APP_DIR=/opt/cocoso
IMAGE=ghcr.io/maskinrepubliken/cocoso:production
HEALTH_URL=http://127.0.0.1:3000/
WAIT_SECONDS=120
MIGRATIONS=/usr/local/share/cocoso/migrations
DUMPS=/var/backups/cocoso/pre-migration
KEEP_DUMPS=5

cd "$APP_DIR"
exec 9>/run/lock/cocoso-deploy.lock
flock -n 9 || { echo "en annan deploy pågår redan" >&2; exit 1; }

healthy() {
  for _ in $(seq 1 $((WAIT_SECONDS / 3))); do
    curl -fsS -o /dev/null --max-time 5 "$HEALTH_URL" && return 0
    sleep 3
  done
  return 1
}

# The app runs as node (uid 1000) and writes uploads to the media volume. A
# volume left owned by root makes every upload fail with EACCES, so hand it
# (and anything in it not already theirs) to uid 1000 on every deploy.
media="$(docker volume ls -q --filter name=^cocoso_media-data$)"
if [[ -n "$media" ]]; then
  docker run --rm -v "$media":/m alpine sh -c \
    'chown 1000:1000 /m && find /m ! -user 1000 -exec chown 1000:1000 {} +'
fi

previous="$(docker inspect --format '{{.Image}}' cocoso-app 2>/dev/null || true)"
echo "kör nu: ${previous:-ingenting}"

docker compose pull --quiet app
next="$(docker image inspect --format '{{.Id}}' "$IMAGE")"
echo "ny image: $next ($(docker image inspect --format '{{index .RepoDigests 0}}' "$IMAGE"))"

# Runs the script on stdin in the database. From a file, not piped into the
# shell: only then does mongosh stop at the first error and exit non-zero.
mongo_script() {
  docker compose exec -T mongo sh -c \
    'f=/tmp/cocoso-script-$$.js; cat > "$f" && mongosh --quiet cocoso --file "$f"; s=$?; rm -f "$f"; exit $s'
}

migrated=""
migrate() {
  # Called as a condition below, so `set -e` is off in here: every step that
  # must not fail says so itself.
  local dir="$1" cid state name flag rest
  local -a all=() pending=() waiting=()

  cid="$(docker create "$IMAGE")" || return 1
  if ! docker cp "$cid:$MIGRATIONS/." "$dir" >/dev/null 2>&1; then
    docker rm "$cid" >/dev/null
    echo "migreringar: imagen har inga med sig; hoppar över"
    return 0
  fi
  docker rm "$cid" >/dev/null
  [[ -r "$dir/ORDER" ]] || { echo "FEL: imagens migreringar saknar filen ORDER" >&2; return 1; }

  state="$(mongo_script <<'JS'
if (db.dataMigrations.estimatedDocumentCount() === 0 && db.users.estimatedDocumentCount() === 0) print('EMPTY');
db.dataMigrations.find({}, { _id: 1 }).forEach((m) => print(`DONE ${m._id}`));
JS
)" || { echo "FEL: kunde inte läsa dataMigrations ur databasen" >&2; return 1; }

  while read -r name flag rest; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    if ! [[ "$name" =~ ^[A-Za-z0-9._-]+\.mongosh\.js$ && -z "$rest" && ( -z "$flag" || "$flag" == manual ) && -r "$dir/$name" ]]; then
      echo "FEL: ogiltig rad i ORDER: $name $flag $rest" >&2; return 1
    fi
    all+=("$name")
    grep -qxF "DONE $name" <<<"$state" && continue
    if [[ "$flag" == manual ]]; then waiting+=("$name"); else pending+=("$name"); fi
  done < "$dir/ORDER"

  (( ${#all[@]} )) || { echo "migreringar: ORDER är tom"; return 0; }

  # A database nobody has used yet is created in today's shape by the app:
  # there is nothing to migrate, so everything is recorded as done.
  if grep -qx EMPTY <<<"$state"; then
    printf 'db.dataMigrations.updateOne({ _id: "%s" }, { $setOnInsert: { appliedAt: new Date(), by: "new-database" } }, { upsert: true });\n' \
      "${all[@]}" | mongo_script >/dev/null || return 1
    echo "migreringar: tom databas; ${#all[@]} bokförda som körda utan att köras"
    return 0
  fi

  if (( ${#waiting[@]} )); then
    printf 'migreringar: VÄNTAR på att köras för hand: %s\n' "${waiting[@]}"
  fi
  if (( ${#pending[@]} == 0 )); then
    echo "migreringar: inga nya"
    return 0
  fi

  local dump
  dump="$DUMPS/mongo-$(date +%Y-%m-%d_%H%M%S).archive.gz"
  mkdir -p "$DUMPS" || return 1
  docker compose exec -T mongo mongodump --quiet --db cocoso --archive --gzip > "$dump" \
    && [[ -s "$dump" ]] || { echo "FEL: databasdumpen misslyckades; kör inga migreringar" >&2; return 1; }
  chmod 640 "$dump"; chgrp backup "$DUMPS" "$dump" 2>/dev/null || true
  ls -1t "$DUMPS"/mongo-*.archive.gz | tail -n +"$((KEEP_DUMPS + 1))" | xargs -r rm -f || true
  echo "migreringar: ${#pending[@]} att köra; databasen dumpad till $dump"
  migrated="$dump"

  for name in "${pending[@]}"; do
    echo "migreringar: kör $name"
    if ! {
      echo 'var APPLY = true;'
      cat "$dir/$name"
      printf '\n;db.dataMigrations.updateOne({ _id: "%s" }, { $set: { appliedAt: new Date(), by: "deploy" } }, { upsert: true });\n' "$name"
    } | mongo_script 2>&1 | sed 's/^/    /'; then
      echo "FEL: $name misslyckades. Databasen kan vara delvis ändrad; dumpen från före körningen: $dump" >&2
      return 1
    fi
  done
  echo "migreringar: klara"
}

migrations_dir="$(mktemp -d)"
trap 'rm -rf "$migrations_dir"' EXIT
if ! migrate "$migrations_dir"; then
  echo "den nya versionen startas inte; ${previous:+$previous kör vidare}" >&2
  [[ -n "$previous" ]] && docker tag "$previous" "$IMAGE"
  exit 1
fi

if [[ "$next" == "$previous" ]]; then
  # Migrations are run before this on purpose: a deploy run again (after a
  # failed migration was fixed by hand, or after this script was updated)
  # still brings the database up to date.
  echo "samma image kör redan; startar inte om"
  healthy && { echo "appen svarar"; exit 0; }
  echo "VARNING: appen svarar inte" >&2
  exit 1
fi

docker compose up -d app
if healthy; then
  echo "appen svarar med den nya imagen"
  docker image prune -f >/dev/null
  exit 0
fi

echo "FEL: appen svarade inte inom ${WAIT_SECONDS} s; senaste loggraderna:" >&2
docker compose logs --tail=40 app >&2 || true
if [[ -n "$previous" ]]; then
  echo "går tillbaka till $previous" >&2
  docker tag "$previous" "$IMAGE"
  docker compose up -d app
  healthy && echo "den tidigare imagen kör och svarar igen" >&2 || echo "VARNING: inte heller den tidigare imagen svarar" >&2
fi
[[ -n "$migrated" ]] && echo "OBS: migreringarna är körda och backas inte av detta; dumpen från före: $migrated" >&2
exit 1
