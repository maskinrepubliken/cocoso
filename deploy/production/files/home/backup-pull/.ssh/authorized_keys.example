# /home/backup-pull/.ssh/authorized_keys (mode 600, owned by backup-pull).
# One line per machine that pulls backups. The key can only run a read-only
# rsync of /var/backups/cocoso, and only from tailnet addresses.
from="100.64.0.0/10,fd7a:115c:a1e0::/48",command="rrsync -ro /var/backups/cocoso",restrict ssh-ed25519 AAAA… <machine>
