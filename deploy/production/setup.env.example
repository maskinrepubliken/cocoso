# Copy to setup.env (gitignored) and fill in. Read by setup.sh.

# The administrator's account on the server; logs in with ADMIN_KEYS.
ADMIN_USER=admin
# Public keys allowed to log in as ADMIN_USER, one per line (keys/ is gitignored).
ADMIN_KEYS=keys/admin.pub

# The site's domain (Caddy gets its certificate for it and www.<domain>).
DOMAIN=kalendern.example.org

# Optional: public keys of machines that pull backups (one per line), and the
# GitHub Actions deploy key. Each gets the restricted line from setup.sh.
BACKUP_PULL_KEYS=keys/backup-pull.pub
DEPLOY_KEY=keys/deploy.pub
