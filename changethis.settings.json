{
  "_readme": "Copy this file to private/settings.json and fill in the values. Every key is documented in docs/CONFIGURATION.md. private/settings.json is gitignored.",
  "public": {
    "packages": {
      "dynamic-import": {
        "useLocationOrigin": true
      }
    },
    "name": "Cocoso",
    "iconsBaseUrl": "https://your-domain.example/icons"
  },
  "media": {
    "storagePath": "/var/lib/cocoso/media",
    "publicUrl": "https://your-domain.example/media"
  },
  "mailCredentials": {
    "smtp": {
      "fromEmail": "Your Platform <noreply@your-domain.example>",
      "userName": "smtp-username",
      "password": "smtp-password",
      "host": "smtp.your-provider.example",
      "port": "587"
    }
  },
  "cdnServer": ""
}
